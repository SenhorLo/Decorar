# ---------------------------------------------------------------------------
# Banco (PostgreSQL). Em producao: Prisma Postgres.
# Pegue a connection string em https://console.prisma.io > seu banco > Connect
# Formato: postgresql://USUARIO:SENHA@db.prisma.io:5432/postgres?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@db.prisma.io:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Chave de assinatura das sessoes (JWT HS256). Minimo de 32 caracteres.
# Gere uma para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-48-bytes-em-base64"

# Origem publica da aplicacao. Em producao: https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Só defina como 1 se a aplicacao estiver atras de um proxy CONFIAVEL que
# reescreve x-forwarded-for (nginx, Cloudflare, um load balancer seu).
#
# Na Vercel nao e necessario: a borda publica x-vercel-forwarded-for, que o
# cliente nao consegue forjar, e o codigo prefere esse cabecalho.
#
# Ligar isso sem proxy na frente permite que qualquer visitante escape de
# todos os limites de taxa (login, cadastro, upload) mandando um
# x-forwarded-for diferente a cada requisicao.
# ---------------------------------------------------------------------------
# TRUST_PROXY_HEADERS="1"

# ---------------------------------------------------------------------------
# Armazenamento das fotos enviadas por usuarios (Vercel Blob).
# O painel do Vercel injeta esta variavel sozinho ao conectar o Blob Store.
# Sem ela, os uploads caem em public/uploads/ no disco local — o que funciona
# em desenvolvimento, mas nao na Vercel (sistema de arquivos somente-leitura).
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
